# Public URL and HTTP port. Put this service behind HTTPS for public deployments.
APP_PORT=8080
PUBLIC_APP_URL=http://localhost:8080

# Use a URL-safe password (letters, numbers, underscore, hyphen) for MongoDB.
MONGO_ROOT_USERNAME=spendwise
MONGO_ROOT_PASSWORD=replace_with_a_long_url_safe_random_password

# Generate two different random values of at least 32 characters.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional providers. The built-in deterministic AI and local OCR work without keys.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
OCR_PROVIDER=none
OCR_API_KEY=
